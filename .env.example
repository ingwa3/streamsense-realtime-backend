# Copy this file to .env before starting the stack.
# Replace all demo credentials. The .env file is excluded from Git.
POSTGRES_DB=streamsense
POSTGRES_USER=streamsense_admin
POSTGRES_PASSWORD=change-me-admin-local-only

# Least-privilege database accounts created on first database initialization.
STREAMSENSE_WRITER_PASSWORD=change-me-writer-local-only
STREAMSENSE_AGGREGATOR_PASSWORD=change-me-aggregator-local-only
STREAMSENSE_READER_PASSWORD=change-me-reader-local-only
PERSISTER_DATABASE_URL=postgresql://streamsense_writer:change-me-writer-local-only@postgres:5432/streamsense
AGGREGATOR_DATABASE_URL=postgresql://streamsense_aggregator:change-me-aggregator-local-only@postgres:5432/streamsense
API_DATABASE_URL=postgresql://streamsense_reader:change-me-reader-local-only@postgres:5432/streamsense

KAFKA_BOOTSTRAP_SERVERS=broker:19092
INPUT_TOPIC=sensor-readings.v1
DLQ_TOPIC=sensor-readings.dlq.v1
CONSUMER_GROUP=streamsense-persister-v2
REPORTING_API_KEY=change-me-reporting-key
LOG_LEVEL=INFO

# Producer defaults
PRODUCER_INSTANCE=simulator-01
SENSOR_COUNT=500
ROOM_COUNT=50
EVENTS_PER_SECOND=250
TOTAL_EVENTS=0
BURST_MODE=false
RANDOM_SEED=42
LATE_EVENT_PROBABILITY=0.02
LATE_EVENT_MAX_SECONDS=90

# Persister defaults
PERSIST_BATCH_SIZE=1000
PERSIST_FLUSH_SECONDS=1.0

# Aggregator defaults
AGGREGATION_INTERVAL_SECONDS=5
ALLOWED_LATENESS_SECONDS=15
AGGREGATION_LOOKBACK_MINUTES=10
RAW_RETENTION_DAYS=30
AGGREGATE_RETENTION_DAYS=365
COMFORT_TEMPERATURE_MIN_C=18
COMFORT_TEMPERATURE_MAX_C=27
COMFORT_HUMIDITY_MIN_PCT=30
COMFORT_HUMIDITY_MAX_PCT=70
CO2_WARNING_PPM=1200
